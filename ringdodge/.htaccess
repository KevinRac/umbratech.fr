# Ring Dodge (version d'essai, ouverte à tous) : le jeu construit est dans jeu/,
# servi à l'adresse /ringdodge/ sans le « jeu/ » dans l'adresse.
Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^jeu/ - [L]
  RewriteRule ^(.*)$ jeu/$1 [L]
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  # Fichiers dont le nom contient leur version (assets/) : cache long ; le reste : toujours revalidé
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
